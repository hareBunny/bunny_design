{
    "name": "@miaoma-design-ai/miaoma-mcp",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "build:sidecar:host": "node scripts/build-sidecar.mjs --host",
        "build:sidecar:win": "node scripts/build-sidecar.mjs win32-x64",
        "lint": "eslint .",
        "format": "prettier --ignore-path ../../.prettierignore --write . && eslint --fix .",
        "format:check": "prettier --ignore-path ../../.prettierignore --check . && eslint .",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "dependencies": {
        "@miaoma-design-ai/miaoma-design-schema": "workspace:*",
        "@modelcontextprotocol/sdk": "1.29.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@yao-pkg/pkg": "6.6.0",
        "esbuild": "0.25.0",
        "tsdown": "^0.22.3",
        "vitest": "^2.1.8"
    }
}
