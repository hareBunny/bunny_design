{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "formatVersion": { "const": 1 },
        "fragmentId": { "type": "string", "minLength": 1 },
        "assignmentId": { "type": "string", "minLength": 1 },
        "nodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "$ref": "#/$defs/node" }
        }
    },
    "required": ["formatVersion", "fragmentId", "assignmentId", "nodes"],
    "$defs": {
        "jsonValue": {
            "anyOf": [
                { "type": "string" },
                { "type": "number" },
                { "type": "boolean" },
                { "type": "null" },
                { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
                {
                    "type": "object",
                    "additionalProperties": { "$ref": "#/$defs/jsonValue" }
                }
            ]
        },
        "fill": {
            "anyOf": [
                { "type": "string" },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": { "enum": ["color", "gradient", "image"] },
                        "color": { "type": "string" },
                        "gradientType": { "enum": ["linear", "radial"] },
                        "rotation": { "type": "number" },
                        "colors": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "color": { "type": "string" },
                                    "position": { "type": "number" }
                                },
                                "required": ["color", "position"]
                            }
                        },
                        "center": { "$ref": "#/$defs/point" },
                        "size": { "$ref": "#/$defs/size" },
                        "url": { "type": "string" },
                        "mode": { "enum": ["fill", "fit", "stretch"] },
                        "width": { "type": "number" },
                        "align": { "enum": ["center", "inner", "outer"] }
                    },
                    "required": ["type"]
                }
            ]
        },
        "styleValue": {
            "anyOf": [
                { "$ref": "#/$defs/fill" },
                { "type": "array", "items": { "$ref": "#/$defs/fill" } }
            ]
        },
        "point": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
            }
        },
        "size": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "width": { "type": "number" },
                "height": { "type": "number" }
            }
        },
        "node": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": {
                    "enum": ["frame", "rectangle", "ellipse", "icon", "text"]
                },
                "name": { "type": "string" },
                "opacity": { "type": "number" },
                "x": { "type": "number" },
                "y": { "type": "number" },
                "rotation": { "type": "number" },
                "width": {
                    "anyOf": [
                        { "type": "number" },
                        { "enum": ["fill_container", "hug_contents"] }
                    ]
                },
                "height": {
                    "anyOf": [
                        { "type": "number" },
                        { "enum": ["fill_container", "hug_contents"] }
                    ]
                },
                "fill": { "$ref": "#/$defs/styleValue" },
                "stroke": { "$ref": "#/$defs/styleValue" },
                "strokeWidth": { "type": "number" },
                "strokeAlignment": { "enum": ["center", "inner", "outer"] },
                "cornerRadius": {
                    "anyOf": [
                        { "type": "number" },
                        { "type": "string" },
                        {
                            "type": "array",
                            "minItems": 4,
                            "maxItems": 4,
                            "items": { "type": "number" }
                        }
                    ]
                },
                "effect": {
                    "anyOf": [
                        { "$ref": "#/$defs/effect" },
                        {
                            "type": "array",
                            "items": { "$ref": "#/$defs/effect" }
                        }
                    ]
                },
                "layout": { "enum": ["none", "horizontal", "vertical"] },
                "gap": { "type": "number" },
                "padding": {
                    "anyOf": [
                        { "type": "number" },
                        {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 4,
                            "items": { "type": "number" }
                        }
                    ]
                },
                "justifyContent": {
                    "enum": [
                        "start",
                        "center",
                        "end",
                        "space_between",
                        "space_around"
                    ]
                },
                "alignItems": { "enum": ["start", "center", "end", "stretch"] },
                "clip": { "type": "boolean" },
                "children": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/node" }
                },
                "icon": { "type": "string" },
                "library": { "type": "string" },
                "content": { "type": "string" },
                "textGrowth": {
                    "enum": ["auto", "fixed-width", "fixed-width-height"]
                },
                "textAlign": { "enum": ["left", "center", "right", "justify"] },
                "fontFamily": { "type": "string" },
                "fontSize": { "type": "number" },
                "fontWeight": { "type": "string" },
                "lineHeight": { "type": "number" }
            },
            "required": ["id", "type"]
        },
        "effect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": { "const": "shadow" },
                "shadowType": { "enum": ["inner", "outer"] },
                "color": { "type": "string" },
                "offset": { "$ref": "#/$defs/point" },
                "blur": { "type": "number" }
            },
            "required": ["type", "color"]
        }
    }
}
